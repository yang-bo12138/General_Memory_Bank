{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "types": ["node"],

    /* ⚠️ §6 大量接口用 `?:` 表达「缺省表示一切按预期落库」（如 `warnings?`）。
     * 严格可选属性检查能在编译期挡住「显式传 `undefined` 与不传」的混淆。 */
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  /* ⚠️ `bench` 进 include（**类型检查要覆盖它**），
   * 但 `tsconfig.build.json` 的 include 只有 `src` ⇒ **构建产物里不含 bench**。
   * ⇒ 理由：bench 是**仓库内的一等代码**（它 import 生产模块、也被冒烟测试 import）
   *   ⇒ 不该脱离类型检查；又它是**测量工具**⇒ 不该进 npm 产物（`files: ["dist"]`）。 */
  "include": ["src", "tests", "scripts", "bench", "vitest.config.ts", "tsup.config.ts"]
}
