# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
*.tsbuildinfo

# 测试与覆盖率
coverage/
.vitest/

# 运行时数据（单文件库 + logs/ 目录，§9.3.1 / §8.1）
*.db
*.db-wal
*.db-shm
logs/

# golden 集的采集产物（基线本体入库，见 scripts/capture-golden.ts）
tests/golden/__captured__/

# 编辑器与系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# 本机验收脚本与临时产物（不提交）
.tmp/
.tmp_arch/

# vite / vitest 加载配置文件时落下的临时文件（会反复出现）
vite.config.ts.timestamp-*.mjs
vitest.config.ts.timestamp-*.mjs

# tsx 在受限临时目录环境下的残留（路径解析退化为字面量 undefined）
undefined/
.tmp_arch/

# D: 盘体检的【人读副本】（★ 本地便利件 · 不入库）
#   ★ 为什么不入库：★ 正式凭据是 `docs/evidence/disk-health.json`（★ 含判据原始量 · ★ 可复算）
#   ⇒ ⇒ 而这份 .txt 是控制台 transcript 的拷贝 ⇒ ⇒ ① 内容与 JSON 重复、② 结论可能过期
#   （★ 例：`check:json-note` 那种「逐字副本」机制**不覆盖它** ⇒ ⇒ 过期了没人会发现）
docs/evidence/disk-health.txt
