{
  "name": "memory-ocean",
  "version": "2.1.0",
  "description": "通用记忆库 v2.1（记忆海版）——TypeScript + better-sqlite3，全同步 API，单文件 SQLite",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.16.1",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:params": "tsx scripts/check-params.ts",
    "check:payload-keys": "tsx scripts/check-payload-keys.ts",
    "check:clock": "tsx scripts/check-clock.ts",
    "check:anchor": "tsx scripts/check-anchor.ts",
    "check:contract-ids": "tsx scripts/check-contract-ids.ts",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run check:params && pnpm run check:payload-keys && pnpm run check:clock && pnpm run check:anchor && pnpm run check:contract-ids",
    "ci": "pnpm run verify"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "keywords": ["memory", "sqlite", "fts5", "forgetting-curve", "knowledge-graph"]
}
